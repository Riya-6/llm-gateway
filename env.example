POSTGRES_DB=llm_gateway
POSTGRES_USER=llm_gateway
POSTGRES_PASSWORD=llm_gateway
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_HOST=localhost
QDRANT_PORT=6333

JWT_SECRET=replace-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=["http://localhost:3000"]

# Real provider API keys — leave unset to skip that provider (its calls will fail,
# which is fine for exercising fallback/circuit-breaker logic against the mock provider).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Mock provider server — run separately: uvicorn app.mock_provider.server:app --port 9100
# Use 127.0.0.1, not localhost — on Windows, httpx resolving "localhost" tries
# IPv6 (::1) first and stalls for ~2s per connection before falling back to IPv4.
MOCK_PROVIDER_URL=http://127.0.0.1:9100

# Set true to make the mock provider the ONLY route (skips OpenAI/Anthropic/Ollama
# entirely) — for fast, clean chaos testing without real-network noise/latency.
GENERATION_MOCK_ONLY=false

# Optional: with GENERATION_MOCK_ONLY=true, also set this to a second mock
# provider instance (different port) to add it as a real fallback route —
# proves actual handoff between providers during a chaos test, not just that
# the primary's circuit breaker opened. Leave unset for the single-provider case.
MOCK_FALLBACK_PROVIDER_URL=

# Optional: with GENERATION_MOCK_ONLY=true, set to "openai"/"anthropic"/"ollama"
# to make that ONE real provider the fallback route instead of a second mock
# instance — mock stays the (admin-toggleable) primary. Takes priority over
# MOCK_FALLBACK_PROVIDER_URL if both are set. Needs the matching API key/Ollama
# actually configured to succeed.
GENERATION_REAL_FALLBACK_PROVIDER=

# Circuit breaker tuning — used by every route's breaker. Defaults match
# CircuitBreaker's own Python defaults; override to compare tradeoffs
# (see scripts/compare_thresholds.py).
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
